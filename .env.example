# Read by scripts/refresh-container.py (the local container). `npm run dev` reads it too (Nuxt loads .env);
# `npm run start` and the container take the same variables from their environment. Never commit real values.
# Delivery API login of your NovaDB instance
NOVA_DELIVERY_URL=https://<your-instance>/apis/delivery/v1/
# A $ in a value needs a backslash (\$): Nuxt's .env loader expands an unescaped $name (to nothing, if unset)
NOVA_DELIVERY_USER=<your-delivery-user>
NOVA_DELIVERY_PASSWORD=
#DEMO_BRANCH=merchDemo
# Public Shopify Storefront token (Buy Button). Both values are required for the buy buttons and the cart;
# scripts/refresh-container.py stops without them. Token: Shopify admin, Buy Button channel.
SHOPIFY_DOMAIN=<your-shop>.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Public origin for canonical/hreflang URLs; without it the ingress headers (X-Forwarded-Proto/Host) are used
#SITE_URL=https://<your-domain>
